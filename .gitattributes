# What ships to consumers.
#
# `composer require` pulls the GitHub dist archive, which honours export-ignore.
# Everything below is development-only: it stays in the git repo (contributors
# clone, so they still get it) but is stripped from the released package.
#
# Deliberately NOT ignored — what the plugin needs at runtime:
#   index.php  index.js  index.css  composer.json  README.md  LICENSE  CHANGELOG.md
#   classes/  config/

/.github/           export-ignore
/.claude/           export-ignore
/dev/               export-ignore
/src/               export-ignore

/.gitattributes     export-ignore
/.gitignore         export-ignore
/.mcp.json          export-ignore
/CLAUDE.md          export-ignore
/DEVELOPMENT.md     export-ignore
/VENDOR-STRATEGY.md export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
